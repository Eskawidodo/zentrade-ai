<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_nav_bar"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="#E60D0E11"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <FrameLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_hq"
                android:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/nav_home_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="HQ"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.05"
                android:includeFontPadding="false" />
        </LinearLayout>

        <View
            android:id="@+id/nav_home_dot"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_dot_primary"
            android:visibility="invisible" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/nav_trading"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_trading_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_trading"
                android:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/nav_trading_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="Trading"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.05"
                android:includeFontPadding="false" />
        </LinearLayout>

        <View
            android:id="@+id/nav_trading_dot"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_dot_primary"
            android:visibility="invisible" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/nav_agents"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_agents_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_agents"
                android:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/nav_agents_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="Agents"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.05"
                android:includeFontPadding="false" />
        </LinearLayout>

        <View
            android:id="@+id/nav_agents_dot"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_dot_primary"
            android:visibility="invisible" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/nav_journal"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_journal_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_journal"
                android:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/nav_journal_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="Journal"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.05"
                android:includeFontPadding="false" />
        </LinearLayout>

        <View
            android:id="@+id/nav_journal_dot"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_dot_primary"
            android:visibility="invisible" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/nav_settings"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_settings_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_settings"
                android:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/nav_settings_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="Settings"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.05"
                android:includeFontPadding="false" />
        </LinearLayout>

        <View
            android:id="@+id/nav_settings_dot"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_dot_primary"
            android:visibility="invisible" />
    </FrameLayout>
</LinearLayout>
